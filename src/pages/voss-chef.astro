---
import '../styles/voss-chef.css';
import Img from '../components/ui/Img.astro';
import LeadForm from '../components/forms/LeadForm.astro';
import GTMHead from '../components/tracking/GTMHead.astro';
import GTMBody from '../components/tracking/GTMBody.astro';
import config from '../../config.json';

const gtmId = config.tracking?.gtm_id || '';
const trackingEnabled = config.tracking?.enabled !== false;
---

<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Voss Chef — Team Building Gastronômico | Casa Voss</title>
    <meta name="description"
        content="Um team building gastronômico que reúne pessoas, estimula a colaboração e transforma a cozinha em um espaço de troca, prática e conexão." />
    <meta property="og:title" content="Voss Chef — Team Building Gastronômico | Casa Voss" />
    <meta property="og:description"
        content="Colaboração que se vive à mesa. Team building gastronômico na Casa Voss em São Paulo." />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://use.typekit.net/ruo8uhd.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@200;300;400;500;700&display=swap"
        rel="stylesheet" />
    <link rel="stylesheet" href="https://npmcdn.com/flatpickr/dist/flatpickr.min.css" />

    {trackingEnabled && gtmId && <GTMHead gtmId={gtmId} />}
</head>

<body>
    {trackingEnabled && gtmId && <GTMBody gtmId={gtmId} />}

    <!-- ═══ NAVBAR ═══ -->
    <nav id="navbar">
        <a href="#" class="nav-logo"><Img src="logo.png" alt="Casa Voss" width={180} class="nav-logo-img" /></a>
        <ul class="nav-links">
            <li><a href="#sobre">Sobre</a></li>
            <li><a href="#estrutura">Estrutura</a></li>
            <li><a href="#experiencia">Experiência</a></li>
            <li><a href="#eventos">Eventos</a></li>
            <li><a href="#espacos">Espaços</a></li>
            <li><a href="#gastronomia">Gastronomia</a></li>
            <li><a href="#galeria">Galeria</a></li>
            <li><a href="#contato">Contato</a></li>
        </ul>
        <button class="nav-hamburger" id="hamburgerBtn" aria-label="Abrir menu">
            <span></span><span></span><span></span>
        </button>
    </nav>

    <!-- ═══ MENU MOBILE ═══ -->
    <div class="mobile-menu" id="mobileMenu">
        <a href="#sobre" class="mobile-link">Sobre</a>
        <a href="#estrutura" class="mobile-link">Estrutura</a>
        <a href="#experiencia" class="mobile-link">Experiência</a>
        <a href="#eventos" class="mobile-link">Eventos</a>
        <a href="#espacos" class="mobile-link">Espaços</a>
        <a href="#gastronomia" class="mobile-link">Gastronomia</a>
        <a href="#galeria" class="mobile-link">Galeria</a>
        <a href="#contato" class="mobile-link">Contato</a>
        <a href="#contato" class="mobile-cta">Solicitar Orçamento</a>
    </div>

    <!-- ═══ HERO SECTION ═══ -->
    <section class="hero">
        <video class="hero-bg" autoplay muted loop playsinline>
            <source src="/video-hero.mp4" type="video/mp4" />
        </video>
        <div class="hero-overlay"></div>
        <div class="hero-content">
            <span class="hero-tag">São Paulo · Voss Chef</span>
            <h1 class="hero-title">Voss Chef: colaboração<br> que se vive <em>à mesa</em></h1>
            <p class="hero-subtitle">Um team building gastronômico que reúne pessoas, estimula a colaboração e transforma a cozinha em um espaço de troca, prática e conexão.</p>
            <div class="hero-actions">
                <button class="btn-primary" onclick="document.getElementById('contato').scrollIntoView({behavior:'smooth'})">Solicite Orçamento</button>
            </div>
        </div>
    </section>

    <!-- ═══ STATS BAR ═══ -->
    <div class="stats-bar">
        <div class="stat-item"><span class="stat-num">4 bancadas</span><span class="stat-label">equipadas</span></div>
        <div class="stat-item"><span class="stat-num">1.000m²</span><span class="stat-label">de área total</span></div>
        <div class="stat-item"><span class="stat-num">5</span><span class="stat-label">ambientes</span></div>
        <div class="stat-item"><span class="stat-num">100</span><span class="stat-label">convidados</span></div>
    </div>

    <!-- ═══ SEÇÃO SOBRE (IGUAL À SEÇÃO SOBRE DE EVENTOS-CORPORATIVOS) ═══ -->
    <section class="sobre" id="sobre">
        <div class="sobre-img" style="background-image: url('https://media.dmove.com.br/clients/casavoss/photos/sobre_voss-chef.webp');"></div>
        <div class="sobre-content">
            <span class="section-tag">Sobre o Voss Chef</span>
            <h2 class="section-title">Uma casa onde<br /> pessoas e gastronomia<br /> <em>ganham contexto</em></h2>
            <p class="section-body">
                O VOSS Chef acontece na Casa VOSS, um espaço criado a partir da união entre hospitalidade, gastronomia e experiência em eventos.<br><br>
                Com ambientes que equilibram estética, funcionalidade e acolhimento, a casa cria o cenário para encontros corporativos mais humanos, sofisticados e intencionais.<br><br>
                A própria Casa VOSS se posiciona como um lugar onde relações ganham contexto e experiências criam memória.
            </p>
        </div>
    </section>

    <!-- ═══ SEÇÃO ESTRUTURA ═══ -->
    <section class="estrutura" id="estrutura">
        <div class="estrutura-header">
            <span class="section-tag">Estrutura</span>
            <h2 class="section-title">Estrutura que<br class="br-mobile" /> coloca a<br class="br-desktop" /> <span class="em-desktop-only">experiência</span><br class="br-mobile" /> <em>em movimento</em></h2>
            <p class="section-body">Ambientes e recursos pensados para transformar a gastronomia em um momento de troca, colaboração e conexão.</p>
        </div>
        <div class="estrutura-grid">
            <div class="espaco-card">
                <div class="espaco-card-img">
                    <img src="https://media.dmove.com.br/clients/casavoss/photos/bancada_voss-chef_resultado.webp" alt="4 bancadas equipadas" loading="lazy" />
                </div>
                <div class="espaco-card-body">
                    <span class="espaco-name">4 bancadas equipadas</span>
                    <span class="espaco-cap">Estrutura completa para dinâmicas culinárias em grupo.</span>
                    <button class="espaco-card-btn" onclick="document.getElementById('contato').scrollIntoView({behavior:'smooth'})">Solicitar orçamento</button>
                </div>
            </div>

            <div class="espaco-card">
                <div class="espaco-card-img">
                    <img src="https://media.dmove.com.br/clients/casavoss/photos/espaco-gourmet_voss-chef.webp" alt="Espaço gourmet" loading="lazy" />
                </div>
                <div class="espaco-card-body">
                    <span class="espaco-name">Espaço gourmet</span>
                    <span class="espaco-cap">Um ambiente preparado para colocar a mão na massa.</span>
                    <button class="espaco-card-btn" onclick="document.getElementById('contato').scrollIntoView({behavior:'smooth'})">Solicitar orçamento</button>
                </div>
            </div>

            <div class="espaco-card">
                <div class="espaco-card-img">
                    <img src="https://media.dmove.com.br/clients/casavoss/photos/ambiente-versatil_voss-chef_resultado.webp" alt="Ambientes versáteis" loading="lazy" />
                </div>
                <div class="espaco-card-body">
                    <span class="espaco-name">Ambientes versáteis</span>
                    <span class="espaco-cap">Espaços que acompanham diferentes formatos de encontros.</span>
                    <button class="espaco-card-btn" onclick="document.getElementById('contato').scrollIntoView({behavior:'smooth'})">Solicitar orçamento</button>
                </div>
            </div>
        </div>
    </section>

    <!-- ═══ SEÇÃO EXPERIÊNCIA ═══ -->
    <section class="experiencia-section" id="experiencia">
        <div class="experiencia-header">
            <span class="section-tag">A Experiência</span>
            <h2 class="section-title">Quando o time<br class="br-mobile" /> sai da rotina,<br class="br-desktop" /><br class="br-mobile" /> <em>novas conexões<br class="br-mobile" /> acontecem</em></h2>
            <p class="section-body">
                O VOSS Chef cria um contexto diferente para equipes que querem se conectar de forma mais espontânea. Sem a formalidade de uma reunião e sem a distância de uma atividade convencional, a cozinha coloca todos no mesmo espaço, com um objetivo em comum.
            </p>
        </div>
        <div class="experiencia-pillars">
            <div class="pillar-card">
                <span class="pillar-text">Mais colaboração</span>
            </div>
            <div class="pillar-card">
                <span class="pillar-text">Mais troca</span>
            </div>
            <div class="pillar-card">
                <span class="pillar-text">Mais proximidade</span>
            </div>
            <div class="pillar-card">
                <span class="pillar-text">Um novo jeito de estar junto</span>
            </div>
        </div>
    </section>

    <!-- ═══ SEÇÃO EVENTOS / FORMATOS ═══ -->
    <section class="eventos-section" id="eventos">
        <div class="eventos-header">
            <span class="section-tag">Formatos de Encontros</span>
            <h2 class="section-title">Um formato que<br class="br-mobile" /> combina com<br class="br-desktop" /><br class="br-mobile" /> <em>diferentes objetivos</em></h2>
        </div>
        <div class="eventos-grid">
            <div class="evento-icon-card">
                <div class="evento-icon">
                    <svg viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                </div>
                <h3 class="evento-title">Team Building</h3>
            </div>

            <div class="evento-icon-card">
                <div class="evento-icon">
                    <svg viewBox="0 0 24 24"><path d="M8 22h8"/><path d="M12 2v20"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
                </div>
                <h3 class="evento-title">Confraternizações</h3>
            </div>

            <div class="evento-icon-card">
                <div class="evento-icon">
                    <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M8 14s1.5 2 4 2 4-2 4-2"/><line x1="9" y1="9" x2="9.01" y2="9"/><line x1="15" y1="9" x2="15.01" y2="9"/></svg>
                </div>
                <h3 class="evento-title">Integração de equipes</h3>
            </div>

            <div class="evento-icon-card">
                <div class="evento-icon">
                    <svg viewBox="0 0 24 24"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>
                </div>
                <h3 class="evento-title">Encontros corporativos</h3>
            </div>

            <div class="evento-icon-card">
                <div class="evento-icon">
                    <svg viewBox="0 0 24 24"><path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6"/><path d="M18 9h1.5a2.5 2.5 0 0 0 0-5H18"/><path d="M4 22h16"/><path d="M18 2H6v7a6 6 0 0 0 12 0V2Z"/></svg>
                </div>
                <h3 class="evento-title">Celebrações de resultados</h3>
            </div>
        </div>
    </section>

    <!-- ═══ SEÇÃO ESPAÇOS ═══ -->
    <section class="espacos-section" id="espacos">
        <div class="espacos-header">
            <span class="section-tag">Nossos Espaços</span>
            <h2 class="section-title">Uma casa<br class="br-mobile" /> que<br class="br-desktop" /> <span class="em-desktop-only">acompanha</span><br class="br-mobile" /> <em>o encontro</em></h2>
            <p class="section-body">Do preparo à celebração, diferentes ambientes podem compor a dinâmica do VOSS Chef.</p>
        </div>
        <div class="espacos-grid-4">
            <div class="espaco-card">
                <div class="espaco-card-img">
                    <img src="https://media.dmove.com.br/clients/casavoss/photos/rooftop_voss-chef.webp" alt="Rooftop Casa Voss" loading="lazy" />
                </div>
                <div class="espaco-card-body">
                    <span class="espaco-name">Rooftop</span>
                    <span class="espaco-cap">Um ambiente amplo e cercado de verde para momentos de descontração e celebração.</span>
                    <button class="espaco-card-btn" onclick="document.getElementById('contato').scrollIntoView({behavior:'smooth'})">Solicitar orçamento</button>
                </div>
            </div>

            <div class="espaco-card">
                <div class="espaco-card-img">
                    <img src="https://media.dmove.com.br/clients/casavoss/photos/garden-lounge_voss-chef_resultado.webp" alt="Garden Lounge Casa Voss" loading="lazy" />
                </div>
                <div class="espaco-card-body">
                    <span class="espaco-name">Garden Lounge</span>
                    <span class="espaco-cap">Uma alternativa ao ar livre para encontros mais intimistas.</span>
                    <button class="espaco-card-btn" onclick="document.getElementById('contato').scrollIntoView({behavior:'smooth'})">Solicitar orçamento</button>
                </div>
            </div>

            <div class="espaco-card">
                <div class="espaco-card-img">
                    <img src="https://media.dmove.com.br/clients/casavoss/photos/ambar_voss-chef.webp" alt="Espaço Âmbar Casa Voss" loading="lazy" />
                </div>
                <div class="espaco-card-body">
                    <span class="espaco-name">Espaço Âmbar</span>
                    <span class="espaco-cap">Um ambiente contemporâneo de 170 m² para até 96 convidados.</span>
                    <button class="espaco-card-btn" onclick="document.getElementById('contato').scrollIntoView({behavior:'smooth'})">Solicitar orçamento</button>
                </div>
            </div>

            <div class="espaco-card">
                <div class="espaco-card-img">
                    <img src="https://media.dmove.com.br/clients/casavoss/photos/salvia_voss-chef.webp" alt="Espaço Sálvia Casa Voss" loading="lazy" />
                </div>
                <div class="espaco-card-body">
                    <span class="espaco-name">Espaço Sálvia</span>
                    <span class="espaco-cap">Um ambiente intimista de 77 m² para até 36 convidados.</span>
                    <button class="espaco-card-btn" onclick="document.getElementById('contato').scrollIntoView({behavior:'smooth'})">Solicitar orçamento</button>
                </div>
            </div>
        </div>
    </section>

    <!-- ═══ SEÇÃO GASTRONOMIA (ALINHADA COM EVENTOS-CORPORATIVOS) ═══ -->
    <section class="gastronomia" id="gastronomia">
        <div class="gastro-img" style="background-image: url('https://media.dmove.com.br/clients/casavoss/photos/gastronomia_voss-chef_resultado.webp');"></div>
        <div class="gastro-content">
            <span class="section-tag">Gastronomia</span>
            <h2 class="section-title">No VOSS Chef,<br class="br-mobile" /> cozinhar é<br class="br-desktop" /><br class="br-mobile" /> <em>apenas o começo</em></h2>
            <p class="section-body">
                A gastronomia conduz a dinâmica, estimula a participação e cria o momento para que o time compartilhe não apenas o preparo, mas também o resultado.<br><br>
                A Casa VOSS trabalha com uma cozinha que une técnica, criatividade e acolhimento, além de propostas gastronômicas desenvolvidas para diferentes formatos de encontros.
            </p>
        </div>
    </section>

    <!-- ═══ SEÇÃO GALERIA ═══ -->
    <section class="galeria-section" id="galeria">
        <div class="galeria-header">
            <span class="section-tag">Galeria</span>
            <h2 class="section-title">É na prática que a<br class="br-desktop" /><br class="br-mobile" /> <em>conexão acontece</em></h2>
        </div>
        <div class="galeria-grid">
            <div class="galeria-grid-item">
                <img src="https://media.dmove.com.br/clients/casavoss/photos/galeria_voss-chef09_resultado.webp" alt="Galeria Voss Chef 09" loading="lazy" />
            </div>
            <div class="galeria-grid-item">
                <img src="https://media.dmove.com.br/clients/casavoss/photos/galeria_voss-chef13_resultado.webp" alt="Galeria Voss Chef 13" loading="lazy" />
            </div>
            <div class="galeria-grid-item">
                <img src="https://media.dmove.com.br/clients/casavoss/photos/galeria_voss-chef10_resultado.webp" alt="Galeria Voss Chef 10" loading="lazy" />
            </div>
            <div class="galeria-grid-item">
                <img src="https://media.dmove.com.br/clients/casavoss/photos/galeria_voss-chef12_resultado.webp" alt="Galeria Voss Chef 12" loading="lazy" />
            </div>
            <div class="galeria-grid-item">
                <img src="https://media.dmove.com.br/clients/casavoss/photos/galeria_voss-chef11_resultado.webp" alt="Galeria Voss Chef 11" loading="lazy" />
            </div>
            <div class="galeria-grid-item">
                <img src="https://media.dmove.com.br/clients/casavoss/photos/galeria_voss-chef08_resultado.webp" alt="Galeria Voss Chef 08" loading="lazy" />
            </div>
            <div class="galeria-grid-item">
                <img src="https://media.dmove.com.br/clients/casavoss/photos/galeria_voss-chef06_resultado.webp" alt="Galeria Voss Chef 06" loading="lazy" />
            </div>
            <div class="galeria-grid-item">
                <img src="https://media.dmove.com.br/clients/casavoss/photos/galeria_voss-chef05_resultado.webp" alt="Galeria Voss Chef 05" loading="lazy" />
            </div>
            <div class="galeria-grid-item">
                <img src="https://media.dmove.com.br/clients/casavoss/photos/galeria_voss-chef04_resultado.webp" alt="Galeria Voss Chef 04" loading="lazy" />
            </div>
            <div class="galeria-grid-item">
                <img src="https://media.dmove.com.br/clients/casavoss/photos/galeria_voss-chef02_resultado.webp" alt="Galeria Voss Chef 02" loading="lazy" />
            </div>
            <div class="galeria-grid-item">
                <img src="https://media.dmove.com.br/clients/casavoss/photos/galeria_voss-chef01_resultado.webp" alt="Galeria Voss Chef 01" loading="lazy" />
            </div>
            <div class="galeria-grid-item">
                <img src="https://media.dmove.com.br/clients/casavoss/photos/galeria_voss-chef14_resultado.webp" alt="Galeria Voss Chef 14" loading="lazy" />
            </div>
        </div>
    </section>

    <!-- LIGHTBOX MODAL FOR GALLERY -->
    <div class="lightbox-modal" id="lightboxModal">
        <button class="lightbox-close" id="lightboxClose" aria-label="Fechar">&times;</button>
        <img src="" alt="Ampliada" class="lightbox-content" id="lightboxImg" />
    </div>

    <!-- ═══ SEÇÃO CONTATO (ESTILO OFICIAL DAS OUTRAS PÁGINAS) ═══ -->
    <section class="contato-section" id="contato">
        <div class="contato-info">
            <span class="section-tag">Próximo passo</span>
            <h2 class="section-title">Que tal tirar<br class="br-mobile" /> sua equipe<br class="br-desktop" /><br class="br-mobile" /><em>da rotina?</em></h2>
            <p class="section-body">Leve o VOSS Chef para o próximo encontro da sua empresa e transforme colaboração em um momento que o time vai lembrar.</p>
        </div>

        <div class="contato-form-wrap">
            <div class="vosschef-form-card">
                <LeadForm
                    formId="voss-chef"
                    project="casavoss"
                    submitUrl="https://server3n8n.dmove.com.br/webhook/casa-voss"
                    submitText="SOLICITAR ORÇAMENTO PERSONALIZADO"
                    prefix="vosschef"
                    gridId="vosschefFormGrid"
                    submitId="vosschefSubmitBtn"
                    honeypot={true}
                    successTitle="Solicitação recebida"
                    successText="Recebemos seu pedido de orçamento para o Voss Chef.<br>Em breve entraremos em contato pelo WhatsApp ou e-mail."
                    fields={[
                        { name: 'form_fields[nome]', id: 'Nome', type: 'text', label: 'Nome', placeholder: 'Nome', autocomplete: 'given-name', maxlength: 100, required: true, full: true, errorText: 'Informe seu nome.', errorId: 'errNome' },
                        { name: 'form_fields[empresa]', id: 'Empresa', type: 'text', label: 'Empresa', placeholder: 'Nome da empresa', autocomplete: 'organization', maxlength: 200, required: true, full: true, errorText: 'Informe sua empresa.', errorId: 'errEmpresa' },
                        {
                            type: 'row',
                            fields: [
                                { name: 'form_fields[telefone]', id: 'Telefone', type: 'tel', label: 'WhatsApp', placeholder: '(11) 9 0000-0000', autocomplete: 'tel', maxlength: 20, required: true, errorText: 'Informe um WhatsApp válido.', errorId: 'errTelefone' },
                                { name: 'form_fields[email]', id: 'Email', type: 'email', label: 'E-mail', placeholder: 'E-mail', autocomplete: 'email', maxlength: 200, required: true, errorText: 'Informe um e-mail válido.', errorId: 'errEmail' },
                            ]
                        },
                        {
                            name: 'form_fields[tipo]', id: 'Tipo', type: 'select', label: 'Tipo de evento', required: true, full: true,
                            errorText: 'Selecione o tipo de evento.', errorId: 'errTipo',
                            options: [
                                { value: '', label: 'Tipo de evento', disabled: true, selected: true },
                                { value: 'Confraternização corporativa', label: 'Confraternização corporativa' },
                                { value: 'Corporativo', label: 'Corporativo' },
                                { value: 'Feiras e Exposições', label: 'Feiras e Exposições' },
                                { value: 'Happy Hour', label: 'Happy Hour' },
                                { value: 'Masterclass e Palestras', label: 'Masterclass e Palestras' },
                                { value: 'Mentorias e Treinamentos', label: 'Mentorias e Treinamentos' },
                                { value: 'Offsite corporativo', label: 'Offsite corporativo' },
                                { value: 'Reuniões de Networking', label: 'Reuniões de Networking' },
                                { value: 'Shows e Festivais', label: 'Shows e Festivais' },
                                { value: 'Workshops, Conferências e Seminários', label: 'Workshops, Conferências e Seminários' },
                                { value: 'Outros', label: 'Outros' },
                            ]
                        },
                        { name: 'form_fields[data]', id: 'Data', type: 'text', label: 'Data pretendida', placeholder: 'Data do evento', readonly: true, required: true, full: true, errorText: 'Informe a data do evento.', errorId: 'errData' },
                        { name: 'form_fields[convidados]', id: 'Convidados', type: 'number', label: 'N° de convidados', placeholder: 'N° de Pessoas', required: true, full: true, errorText: 'Informe o número de pessoas.', errorId: 'errConvidados' },
                        { name: 'form_fields[fonte]', id: 'Fonte', type: 'hidden', value: 'Site Casa Voss / LP Voss Chef' },
                    ]}
                />
            </div>
        </div>
    </section>

