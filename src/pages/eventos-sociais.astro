---
import '../styles/eventos-sociais.css';
import Img from '../components/ui/Img.astro';
import LeadForm from '../components/forms/LeadForm.astro';
import GTMHead from '../components/tracking/GTMHead.astro';
import GTMBody from '../components/tracking/GTMBody.astro';
import config from '../../config.json';
const gtmId = config.tracking?.gtm_id || '';
const trackingEnabled = config.tracking?.enabled !== false;
---

<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Casa Voss — Espaço de Eventos Sociais</title>
    <meta name="description"
        content="Casa Voss — Espaço de eventos sociais em São Paulo. Casamentos, aniversários, formaturas e celebrações para até 100 pessoas. Sofisticação e acolhimento para os momentos mais especiais da sua vida." />
    <meta property="og:title" content="Casa Voss — Espaço de Eventos Sociais" />
    <meta property="og:description"
        content="Sofisticação e acolhimento para transformar sua celebração em uma experiência inesquecível." />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://use.typekit.net/ruo8uhd.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@200;300;400;500;700&display=swap"
        rel="stylesheet" />
    <link rel="stylesheet" href="https://npmcdn.com/flatpickr/dist/flatpickr.min.css" />

    {trackingEnabled && gtmId && <GTMHead gtmId={gtmId} />}
</head>

<body>
    {trackingEnabled && gtmId && <GTMBody gtmId={gtmId} />}

    <nav id="navbar">
        <a href="#" class="nav-logo"><Img src="logo.png" alt="Casa Voss" width={180} class="nav-logo-img" /></a>
        <ul class="nav-links">
            <li><a href="#espacos">Espaços</a></li>
            <li><a href="#experiencia">Experiências</a></li>
            <li><a href="#galeria">Galeria</a></li>
            <li><a href="#contato">Contato</a></li>
        </ul>
        <a href="#contato" class="nav-cta" style="display:none!important;">Reservar</a>
        <button class="nav-hamburger" id="hamburgerBtn"
            aria-label="Abrir menu"><span></span><span></span><span></span></button>
    </nav>

    <div class="mobile-menu" id="mobileMenu">
        <a href="#espacos" class="mobile-link">Espaços</a>
        <a href="#experiencia" class="mobile-link">Experiências</a>
        <a href="#galeria" class="mobile-link">Galeria</a>
        <a href="#contato" class="mobile-link">Contato</a>
        <a href="#contato" class="mobile-cta">Reservar</a>
    </div>

    <section class="hero">
        <video class="hero-bg" autoplay muted loop playsinline>
            <source src="/video-hero.mp4" type="video/mp4">
        </video>
        <div class="hero-overlay"></div>
        <div class="hero-content">
            <span class="hero-tag">São Paulo · Espaço para Eventos Sociais</span>
            <h1 class="hero-title">Para celebrações que pedem<br>mais do que estrutura.<br><em>Pedem presença.</em></h1>
            <p class="hero-subtitle">Um espaço contemporâneo para eventos sociais que valorizam presença, sensações e experiências memoráveis.</p>
            <div class="hero-actions"><a href="#espacos" class="btn-primary">Conhecer espaços</a></div>
        </div>
    </section>

    <div class="stats-bar">
        <div class="stat-item"><span class="stat-num">1.000m²</span><span class="stat-label">de área total</span></div>
        <div class="stat-item"><span class="stat-num">5</span><span class="stat-label">ambientes</span></div>
        <div class="stat-item"><span class="stat-num">100</span><span class="stat-label">convidados</span></div>
    </div>

    <section class="sobre">
        <div class="sobre-img"></div>
        <div class="sobre-content">
            <span class="section-tag">Sobre o espaço</span>
            <h2 class="section-title">Onde encontros ganham<br><em>novos significados</em></h2>
            <p class="section-body">A Casa VOSS é ideal para quem entende que receber vai além da ocasião: é sobre criar memórias, conexões e experiências autênticas.<br>Localizada no <b>Brooklin</b>, em São Paulo, a casa une fácil acesso a uma atmosfera sofisticada e acolhedora, distante do padrão tradicional dos espaços convencionais.<br>Com aproximadamente <b>1.000m² de ambientes versáteis</b>, integrando lounges, áreas gourmet, rooftop e espaços de convivência, a Casa VOSS foi desenhada para receber desde encontros intimistas até celebrações de até 100 convidados, com fluidez entre gastronomia, experiência e acolhimento.<br>Uma casa criada para celebrar momentos com essência.</p>
        </div>
    </section>

    <section class="espacos" id="espacos">
        <div class="espacos-header">
            <span class="section-tag">Nossos espaços</span>
            <h2 class="section-title">Ambientes que convidam<br><em>a permanecer</em></h2>
            <p class="espacos-desc">Espaços que se adaptam com elegância a encontros intimistas ou celebrações completas.</p>
        </div>
        <div class="espacos-grid">
            <div class="espaco-card">
                <div class="espaco-card-img"><Img src="galeria01.jpeg" alt="Espaco Ambar Casa Voss" width={800} /></div>
                <div class="espaco-card-body"><span class="espaco-name">Espaço Âmbar</span><span class="espaco-cap">Um ambiente contemporâneo de 170m² para até 96 convidados, ideal para aniversários, celebrações especiais, mini weddings e encontros sociais que pedem sofisticação, conforto e versatilidade.</span><button class="espaco-card-btn"
                        onclick="document.getElementById('contato').scrollIntoView({behavior:'smooth'})">Solicitar
                        orçamento</button></div>
            </div>
            <div class="espaco-card">
                <div class="espaco-card-img"><Img src="espaco-ambar.png" alt="Espaco Salvia Casa Voss" width={800} /></div>
                <div class="espaco-card-body"><span class="espaco-name">Espaço Sálvia</span><span class="espaco-cap">Um espaço intimista de 77m² para até 36 convidados, perfeito para encontros reservados, jantares especiais, comemorações afetivas e experiências mais próximas e acolhedoras.</span><button class="espaco-card-btn"
                        onclick="document.getElementById('contato').scrollIntoView({behavior:'smooth'})">Solicitar
                        orçamento</button></div>
            </div>
            <div class="espaco-card">
                <div class="espaco-card-img"><Img src="gourmet.jpg" alt="Espaco Gourmet Casa Voss" width={800} /></div>
                <div class="espaco-card-body"><span class="espaco-name">Espaço Gourmet</span><span class="espaco-cap">Um ambiente onde gastronomia e convivência se encontram, ideal para almoços, jantares, experiências com chefs convidados e celebrações ao redor da boa mesa.</span><button class="espaco-card-btn"
                        onclick="document.getElementById('contato').scrollIntoView({behavior:'smooth'})">Solicitar
                        orçamento</button></div>
            </div>
            <div class="espaco-card">
                <div class="espaco-card-img"><Img src="garden-lounge.jpeg" alt="Garden Lounge Casa Voss" width={800} /></div>
                <div class="espaco-card-body"><span class="espaco-name">Garden Lounge</span><span class="espaco-cap">Um espaço ao ar livre de 85m² para até 36 convidados, cercado de natureza e acolhimento, ideal para brunches, encontros intimistas e celebrações leves e descontraídas.</span><button class="espaco-card-btn"
                        onclick="document.getElementById('contato').scrollIntoView({behavior:'smooth'})">Solicitar
                        orçamento</button></div>
            </div>
            <div class="espaco-card">
                <div class="espaco-card-img"><Img src="rooftop.jpeg" alt="Rooftop Casa Voss" width={800} /></div>
                <div class="espaco-card-body"><span class="espaco-name">Rooftop</span><span class="espaco-cap">Com 210m² de terraço e 42m² de área coberta, um ambiente amplo, versátil e rodeado de verde, perfeito para coquetéis, sunsets, aniversários e celebrações ao ar livre.</span><button class="espaco-card-btn"
                        onclick="document.getElementById('contato').scrollIntoView({behavior:'smooth'})">Solicitar
                        orçamento</button></div>
            </div>
        </div>
    </section>

    <section class="experiencia-voss" id="experiencia">
        <div class="experiencia-voss-header">
            <span class="section-tag">A experiência Voss</span>
            <h2 class="section-title">Diferentes formas de celebrar,<br><em>mesma essência acolhedora</em></h2>
            <p class="section-body">Experiências sociais pensadas para celebrar conexões, histórias e momentos especiais.</p>
        </div>
        <div class="exp-tipos-grid">
            <div class="exp-tipo-card">
                <div class="exp-tipo-icon"><Img src="voss-experience-sf.png" alt="Voss Experience" width={400} quality={95} /></div>
                <p class="exp-tipo-desc">Estrutura completa para aniversários, mini weddings, celebrações sociais e encontros especiais.</p>
            </div>
            <div class="exp-tipo-card">
                <div class="exp-tipo-icon"><Img src="voss-gourmet-sf.png" alt="Voss Gourmet" width={400} quality={95} /></div>
                <p class="exp-tipo-desc">Experiências gastronômicas exclusivas com menus autorais e serviço impecável. Um convite para celebrar ao redor da mesa.</p>
            </div>
            <div class="exp-tipo-card">
                <div class="exp-tipo-icon"><Img src="voss-chef-sf.png" alt="Voss Chef" width={400} quality={95} /></div>
                <p class="exp-tipo-desc">Experiências gastronômicas interativas para grupos e convidados, com estrutura completa para vivências culinárias que unem descontração, troca e conexão.</p>
            </div>
            <div class="exp-tipo-card">
                <div class="exp-tipo-icon"><Img src="voss-em-casa-sf.png" alt="Voss em Casa" width={400} quality={95} /></div>
                <p class="exp-tipo-desc">A assinatura da nossa cozinha também presente no dia a dia, com uma rotisserie premium que combina praticidade, afeto e sabor em cada detalhe.</p>
            </div>
        </div>
    </section>

    <section class="gastronomia">
        <div class="gastro-img"></div>
        <div class="gastro-content">
            <span class="section-tag">Gastronomia</span>
            <h2 class="section-title">Gastronomia que<br><em>acolhe e surpreende</em></h2>
            <p class="section-body">Assinada pelo <b>chef Eliézer Formaggio</b>, que traz a essência italiana da sua família para cada criação, e complementada por chefs parceiros, a cozinha une técnica, afeto e criatividade em experiências que acolhem e surpreendem.</p>
            <p class="section-body">Cada proposta gastronômica é desenvolvida de forma personalizada, respeitando o estilo da celebração, o perfil dos convidados e a atmosfera de cada encontro.</p>
            <div class="gastro-assinatura">
                <div class="gastro-assinatura-linha"></div><span class="gastro-assinatura-text">Chef Eliézer
                    Formaggio</span>
                <div class="gastro-assinatura-linha"></div>
            </div>
        </div>
    </section>

    <section class="diferenciais">
        <div class="diferenciais-header">
            <span class="section-tag">Diferenciais</span>
            <h2 class="section-title">Detalhes pensados<br><em>para surpreender</em></h2>
            <p class="section-body">Elementos cuidadosamente selecionados para criar experiências acolhedoras e sofisticadas.</p>
        </div>
        <div class="diferenciais-grid">
            <div class="dif-card">
                <div class="dif-card-icon"><svg viewBox="0 0 24 24">
                        <path d="M20 9V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v3" />
                        <path d="M2 11v5a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-5a2 2 0 0 0-4 0z" />
                        <path d="M4 18v2" />
                        <path d="M20 18v2" />
                    </svg></div><span class="dif-card-title">Mobiliário</span>
            </div>
            <div class="dif-card">
                <div class="dif-card-icon"><svg viewBox="0 0 24 24">
                        <path d="M8 2h8l4 10H4L8 2z" />
                        <path d="M12 12v6" />
                        <path d="M8 22v-2a4 4 0 0 1 8 0v2" />
                        <line x1="7" y1="12" x2="7" y2="18" />
                        <line x1="17" y1="12" x2="17" y2="18" />
                    </svg></div><span class="dif-card-title">Bar de drinks</span>
            </div>
            <div class="dif-card">
                <div class="dif-card-icon"><svg viewBox="0 0 24 24">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                        <path d="M12 8v4" />
                        <path d="M10 10h4" />
                    </svg></div><span class="dif-card-title">Paisagismo</span>
            </div>
            <div class="dif-card">
                <div class="dif-card-icon"><svg viewBox="0 0 24 24">
                        <path d="M9 18V5l12-2v13" />
                        <circle cx="6" cy="18" r="3" />
                        <circle cx="18" cy="16" r="3" />
                    </svg></div><span class="dif-card-title">Som e luz</span>
            </div>
            <div class="dif-card">
                <div class="dif-card-icon"><svg viewBox="0 0 24 24">
                        <path d="M9 11l3 3L22 4" />
                        <path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11" />
                    </svg></div><span class="dif-card-title">Cozinha gourmet</span>
            </div>
        </div>
    </section>

    <div class="galeria-header" id="galeria">
        <span class="section-tag">Galeria</span>
        <h2 class="section-title">Uma casa projetada para<br><em><b>encontros memoráveis</b></em></h2>
    </div>
    <div class="galeria">
        <div class="galeria-item"><Img src="galeria02.jpeg" alt="" width={800} /></div>
        <div class="galeria-item"><Img src="recepcao.jpg" alt="" width={800} /></div>
        <div class="galeria-item"><Img src="salas.jpg" alt="" width={800} /></div>
        <div class="galeria-item"><Img src="estar.jpg" alt="" width={800} /></div>
        <div class="galeria-item"><Img src="pocket-auditorio.jpg" alt="" width={800} /></div>
        <div class="galeria-item"><Img src="espaco-salvia.png" alt="" width={800} /></div>
    </div>

    <section class="contato-section" id="contato">
        <div class="contato-info">
            <span class="section-tag">Próximo passo</span>
            <h2 class="section-title">Vamos criar juntos a sua<br><em>próxima celebração?</em></h2>
            <p class="section-body">Preencha seus dados e receba um orçamento personalizado.</p>
        </div>
        <div class="contato-form-wrap">
            <div class="sociais-form-card">
                <LeadForm
                    formId="sociais"
                    project="casavoss"
                    submitUrl="https://server3n8n.dmove.com.br/webhook/casa-voss"
                    submitText="SOLICITAR ORÇAMENTO PERSONALIZADO"
                    prefix="sociais"
                    gridId="sociaisFormGrid"
                    submitId="sociaisSubmitBtn"
                    honeypot={true}
                    successTitle="Solicitação recebida"
                    successText="Recebemos seu pedido de orçamento.<br>Em breve entraremos em contato pelo WhatsApp ou e-mail."
                    fields={[
                        { name: 'form_fields[nome]', id: 'Nome', type: 'text', label: 'Nome', placeholder: 'Nome', autocomplete: 'given-name', maxlength: 100, required: true, full: true, errorText: 'Informe seu nome.', errorId: 'errNome' },
                        {
                            type: 'row',
                            fields: [
                                { name: 'form_fields[telefone]', id: 'Telefone', type: 'tel', label: 'WhatsApp', placeholder: '(11) 9 0000-0000', autocomplete: 'tel', maxlength: 20, required: true, errorText: 'Informe um WhatsApp válido.', errorId: 'errTelefone' },
                                { name: 'form_fields[email]', id: 'Email', type: 'email', label: 'E-mail', placeholder: 'E-mail', autocomplete: 'email', maxlength: 200, required: true, errorText: 'Informe um e-mail válido.', errorId: 'errEmail' },
                            ]
                        },
                        {
                            name: 'form_fields[tipo]', id: 'Tipo', type: 'select', label: 'Tipo de evento', required: true, full: true,
                            errorText: 'Selecione o tipo de evento.', errorId: 'errTipo',
                            options: [
                                { value: '', label: 'Tipo de evento', disabled: true, selected: true },
                                { value: 'Aniversário', label: 'Aniversário' },
                                { value: 'Aniversário debutante', label: 'Aniversário debutante' },
                                { value: 'Bodas', label: 'Bodas' },
                                { value: 'Casamento', label: 'Casamento' },
                                { value: 'Chá de bebê', label: 'Chá de bebê' },
                                { value: 'Chá de panela', label: 'Chá de panela' },
                                { value: 'Confraternização social', label: 'Confraternização social' },
                                { value: 'Formatura', label: 'Formatura' },
                                { value: 'Happy Hour', label: 'Happy Hour' },
                                { value: 'Jantar especial', label: 'Jantar especial' },
                                { value: 'Shows e Festivais', label: 'Shows e Festivais' },
                                { value: 'Outros', label: 'Outros' },
                            ]
                        },
                        { name: 'form_fields[data]', id: 'Data', type: 'text', label: 'Data pretendida', placeholder: 'Data do evento', readonly: true, required: true, full: true, errorText: 'Informe a data do evento.', errorId: 'errData' },
                        { name: 'form_fields[convidados]', id: 'Convidados', type: 'number', label: 'N° de convidados', placeholder: 'N° de Pessoas', required: true, full: true, errorText: 'Informe o número de pessoas.', errorId: 'errConvidados' },
                        { name: 'form_fields[fonte]', id: 'Fonte', type: 'hidden', value: 'Site Casa Voss / Formulário de orçamento — Eventos Sociais' },
                    ]}
                />
            </div>
        </div>
    </section>

    <!-- ═══ WHATSAPP FLOAT + POPUP ═══ -->
    <a href="#" id="wppFloatBtn" class="wpp-float" aria-label="Abrir WhatsApp">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1219.547 1225.016">
            <path fill="#E0E0E0"
                d="M1041.858 178.02C927.206 63.289 774.753.07 612.325 0 277.617 0 5.232 272.298 5.098 606.991c-.039 106.986 27.915 211.42 81.048 303.476L0 1225.016l321.898-84.406c88.689 48.368 188.547 73.855 290.166 73.896h.258.003c334.654 0 607.08-272.346 607.222-607.023.056-162.208-63.052-314.724-177.689-429.463zm-429.533 933.963h-.197c-90.578-.048-179.402-24.366-256.878-70.339l-18.438-10.93-191.021 50.083 51-186.176-12.013-19.087c-50.525-80.336-77.198-173.175-77.16-268.504.111-278.186 226.507-504.503 504.898-504.503 134.812.056 261.519 52.604 356.814 147.965 95.289 95.36 147.728 222.128 147.688 356.948-.118 278.195-226.522 504.543-504.693 504.543z" />
            <linearGradient id="a" gradientUnits="userSpaceOnUse" x1="609.77" y1="1190.114" x2="609.77" y2="21.084">
                <stop offset="0" stop-color="#20b038" />
                <stop offset="1" stop-color="#60d66a" />
            </linearGradient>
            <path fill="url(#a)"
                d="M27.875 1190.114l82.211-300.18c-50.719-87.852-77.391-187.523-77.359-289.602.133-319.398 260.078-579.25 579.469-579.25 155.016.07 300.508 60.398 409.898 169.891 109.414 109.492 169.633 255.031 169.57 409.812-.133 319.406-260.094 579.281-579.445 579.281-.023 0 .016 0 0 0 0h-.258c-96.977-.031-192.266-24.375-276.898-70.5l-307.188 80.548z" />
            <path fill-rule="evenodd" clip-rule="evenodd" fill="#FFF"
                d="M462.273 349.294c-11.234-24.977-23.062-25.477-33.75-25.914-8.742-.375-18.75-.352-28.742-.352-10 0-26.25 3.758-39.992 18.766-13.75 15.008-52.5 51.289-52.5 125.078 0 73.797 53.75 145.102 61.242 155.117 7.5 10 103.758 166.266 256.203 226.383 126.695 49.961 152.477 40.023 179.977 37.523s88.734-36.273 101.234-71.297c12.5-35.016 12.5-65.031 8.75-71.305-3.75-6.25-13.75-10-28.75-17.5s-88.734-43.789-102.484-48.789-23.75-7.5-33.75 7.516c-10 15-38.727 48.773-47.477 58.773-8.75 10.023-17.5 11.273-32.5 3.773-15-7.523-63.305-23.344-120.609-74.438-44.586-39.75-74.688-88.844-83.438-103.859-8.75-15-.938-23.125 6.586-30.602 6.734-6.719 15-17.508 22.5-26.266 7.484-8.758 9.984-15.008 14.984-25.008 5-10.016 2.5-18.773-1.25-26.273s-32.898-81.67-46.234-111.326z" />
            <path fill="#FFF"
                d="M1036.898 176.091C923.562 62.677 772.859.185 612.297.114 281.43.114 12.172 269.286 12.039 600.137 12 705.896 39.633 809.13 92.156 900.13L7 1211.067l318.203-83.438c87.672 47.812 186.383 73.008 286.836 73.047h.255.003c330.812 0 600.109-269.219 600.25-600.055.055-160.343-62.328-311.108-175.649-424.53zm-424.601 923.242h-.195c-89.539-.047-177.344-24.086-253.93-69.531l-18.227-10.805-188.828 49.508 50.414-184.039-11.875-18.867c-49.945-79.414-76.312-171.188-76.273-265.422.109-274.992 223.906-498.711 499.102-498.711 133.266.055 258.516 52 352.719 146.266 94.195 94.266 146.031 219.578 145.992 352.852-.118 274.999-223.923 498.749-498.899 498.749z" />
        </svg>
    </a>

    <div class="wpp-overlay" id="wppOverlay"></div>
    <div class="wpp-wrap" id="wppWrap">
        <div class="wpp-box">
            <div class="wpp-hdr">
                <div class="wpp-hdr-av">🌿</div>
                <div class="wpp-hdr-info">
                    <div class="wpp-hdr-name">Casa Voss</div>
                    <div class="wpp-hdr-status">Online</div>
                </div>
                <button class="wpp-hdr-close" id="wppClose" aria-label="Fechar"><svg viewBox="0 0 24 24">
                        <line x1="18" y1="6" x2="6" y2="18" />
                        <line x1="6" y1="6" x2="18" y2="18" />
                    </svg></button>
            </div>
            <div class="wpp-chat" id="wppChat"></div>
            <div class="wpp-bar" id="wppBar"></div>
        </div>
    </div>

    <footer>
        <div class="footer-brand">
            <a href="#" class="nav-logo"><Img src="logo.png" alt="Casa Voss" width={180} class="nav-logo-img" /></a>
            <p class="footer-desc">Espaço de eventos sociais em São Paulo. Sofisticação, acolhimento e experiências
                únicas para os seus momentos mais especiais.</p>
