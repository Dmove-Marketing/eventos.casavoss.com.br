---
// Componente gerado a partir de: eventos-corporativos.html
import '../styles/index.css';
import Img from '../components/ui/Img.astro';
import LeadForm from '../components/forms/LeadForm.astro';
import StaticMap from '../components/ui/StaticMap.astro';
import GTMHead from '../components/tracking/GTMHead.astro';
import GTMBody from '../components/tracking/GTMBody.astro';
import config from '../../config.json';
const gtmId = config.tracking?.gtm_id || '';
const trackingEnabled = config.tracking?.enabled !== false;
---

<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Casa Voss — Espaço de Eventos Corporativos</title>
    <meta name="description"
        content="Casa Voss — Espaço de eventos corporativos em São Paulo. Auditório, salas, gourmet e lounge para até 250 pessoas. Sofisticação e acolhimento para a sua marca." />
    <meta property="og:title" content="Casa Voss — Espaço de Eventos Corporativos" />
    <meta property="og:description"
        content="Sofisticação e acolhimento para transformar seu evento em uma experiência inesquecível." />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://use.typekit.net/ruo8uhd.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@200;300;400;500;700&display=swap"
        rel="stylesheet" />
    <link rel="stylesheet" href="https://npmcdn.com/flatpickr/dist/flatpickr.min.css" />

    {trackingEnabled && gtmId && <GTMHead gtmId={gtmId} />}
</head>

<body>
    {trackingEnabled && gtmId && <GTMBody gtmId={gtmId} />}

    <nav id="navbar">
        <a href="#" class="nav-logo"><Img src="logo.png" alt="Casa Voss" width={180} class="nav-logo-img" /></a>
        <ul class="nav-links">
            <li><a href="#">Home</a></li>
            <li><a href="#espacos">Espaço</a></li>
            <li><a href="#experiencia">Eventos</a></li>
            <li><a href="#galeria">Galeria</a></li>
            <li><a href="#localizacao">Localização</a></li>
            <li><a href="#contato">Contato</a></li>
        </ul>
        <a href="#contato" class="nav-cta" style="display:none!important;">Reservar</a>
        <button class="nav-hamburger" id="hamburgerBtn"
            aria-label="Abrir menu"><span></span><span></span><span></span></button>
    </nav>

    <div class="mobile-menu" id="mobileMenu">
        <a href="#" class="mobile-link">Home</a>
        <a href="#espacos" class="mobile-link">Espaço</a>
        <a href="#experiencia" class="mobile-link">Eventos</a>
        <a href="#galeria" class="mobile-link">Galeria</a>
        <a href="#localizacao" class="mobile-link">Localização</a>
        <a href="#contato" class="mobile-link">Contato</a>
        <a href="#contato" class="mobile-cta">Reservar</a>
    </div>

    <section class="hero">
        <video class="hero-bg" autoplay muted loop playsinline>
            <source src="/video-hero.mp4" type="video/mp4">
        </video>
        <div class="hero-overlay"></div>
        <div class="hero-content">
            <span class="hero-tag">PRINCIPAL</span>
            <h1 class="hero-title">Uma casa que une estratégia,<br>hospitalidade, estética e <em>experiência.</em></h1>
            <div class="hero-actions"><button class="btn-primary" onclick="document.getElementById('contato').scrollIntoView({behavior:'smooth'})">Solicite orçamento</button></div>
        </div>
    </section>

    <div class="stats-bar">
        <div class="stat-item"><span class="stat-num">1.000m²</span><span class="stat-label">de área total</span></div>
        <div class="stat-item"><span class="stat-num">5</span><span class="stat-label">ambientes</span></div>
        <div class="stat-item"><span class="stat-num">100</span><span class="stat-label">convidados</span></div>
    </div>

    <section class="sobre">
        <div class="sobre-img"></div>
        <div class="sobre-content">
            <span class="section-tag">Sobre o espaço</span>
            <h2 class="section-title">Mais do que receber pessoas.<br><em>Criamos atmosfera.</em></h2>
            <p class="section-body">A Casa VOSS reúne arquitetura, gastronomia e uma curadoria especializada para transformar eventos corporativos, celebrações e experiências em momentos com presença, conexão e significado.<br><br>Localizada no Brooklin, em São Paulo, com aproximadamente 1.000m², seus diferentes ambientes se integram para receber encontros intimistas, lançamentos, treinamentos, jantares, gravações e eventos de até 100 convidados.</p>
            <div class="sobre-tags">
                <span class="badge">Eventos corporativos e sociais</span>
                <span class="badge">Gastronomia autoral</span>
                <span class="badge">Estrutura para experiências gastronômicas</span>
            </div>
        </div>
    </section>

    <section class="espacos" id="espacos">
        <div class="espacos-header">
            <span class="section-tag">Nossos espaços</span>
            <h2 class="section-title">Espaços que acompanham a<br><em>dinâmica de cada encontro</em></h2>
            <p class="espacos-desc">Cada ambiente da Casa VOSS foi pensado para diferentes ritmos, formatos e experiências, equilibrando estética, funcionalidade e acolhimento.</p>
        </div>
        <div class="espacos-grid">
            <div class="espaco-card">
                <div class="espaco-card-img"><Img src="recepcao.jpg" alt="Espaco Ambar Casa Voss" width={800} /></div>
                <div class="espaco-card-body"><span class="espaco-name">Espaço Âmbar</span><span class="espaco-cap">Um auditório contemporâneo de 170m² para até 96 convidados, ideal para apresentações, treinamentos e lançamentos, com formato plenária ou mesas redondas, combinando tecnologia, conforto e estética para potencializar a experiência.</span><button class="espaco-card-btn"
                        onclick="document.getElementById('contato').scrollIntoView({behavior:'smooth'})">Solicitar
                        orçamento</button></div>
            </div>
            <div class="espaco-card">
                <div class="espaco-card-img"><Img src="espaco-salvia.png" alt="Espaco Salvia Casa Voss" width={800} /></div>
                <div class="espaco-card-body"><span class="espaco-name">Espaço Sálvia</span><span class="espaco-cap">Um ambiente intimista de 77m² para até 36 convidados, ideal para workshops, mentorias e reuniões estratégicas, pensado para encontros que pedem mais conexão.</span><button class="espaco-card-btn"
                        onclick="document.getElementById('contato').scrollIntoView({behavior:'smooth'})">Solicitar
                        orçamento</button></div>
            </div>
            <div class="espaco-card">
                <div class="espaco-card-img"><Img src="gourmet.jpg" alt="Espaco Gourmet Casa Voss" width={800} /></div>
                <div class="espaco-card-body"><span class="espaco-name">Espaço Gourmet</span><span class="espaco-cap">Um
                        espaço onde o networking se mistura à gastronomia, <b>ideal para coffee breaks, almoços e
                            ativações com chefs convidados.</b></span><button class="espaco-card-btn"
                        onclick="document.getElementById('contato').scrollIntoView({behavior:'smooth'})">Solicitar
                        orçamento</button></div>
            </div>
            <div class="espaco-card">
                <div class="espaco-card-img"><Img src="garden-lounge.jpeg" alt="Garden Lounge Casa Voss" width={800} /></div>
                <div class="espaco-card-body"><span class="espaco-name">Garden Lounge</span><span class="espaco-cap">Um espaço ao ar livre de 85m² para até 36 convidados, que combina natureza e acolhimento, ideal para workshops, treinamentos e reuniões estratégicas mais intimistas.</span><button class="espaco-card-btn"
                        onclick="document.getElementById('contato').scrollIntoView({behavior:'smooth'})">Solicitar
                        orçamento</button></div>
            </div>
            <div class="espaco-card">
                <div class="espaco-card-img"><Img src="rooftop.jpeg" alt="Rooftop Casa Voss" width={800} /></div>
                <div class="espaco-card-body"><span class="espaco-name">Rooftop</span><span class="espaco-cap">Com 210m²
                        de terraço e 42m² de área coberta, um espaço amplo, versátil e cercado de verde, ideal para
                        almoços, coquetéis e celebrações ao ar livre.</span><button class="espaco-card-btn"
                        onclick="document.getElementById('contato').scrollIntoView({behavior:'smooth'})">Solicitar
                        orçamento</button></div>
            </div>
        </div>
    </section>

    <section class="experiencia-voss" id="experiencia">
        <div class="experiencia-voss-header">
            <span class="section-tag">Eventos</span>
            <h2 class="section-title">Experiências desenhadas para conectar<br><em>pessoas, marcas e momentos</em></h2>
        </div>
        <div class="exp-tipos-grid">
            <div class="exp-tipo-card">
                <div class="exp-tipo-icon"><Img src="voss-experience-sf.png" alt="Voss Experience" width={120} /></div>
                <p class="exp-tipo-desc">Soluções completas para eventos corporativos, treinamentos, lançamentos e produções audiovisuais. Ambientes flexíveis, infraestrutura técnica e cenários planejados para gerar impacto, conexão e performance.</p>
            </div>
            <div class="exp-tipo-card">
                <div class="exp-tipo-icon"><Img src="voss-gourmet-sf.png" alt="Voss Gourmet" width={120} /></div>
                <p class="exp-tipo-desc">Alta gastronomia para almoços e jantares exclusivos, com menus autorais e serviço impecável. Uma experiência onde o receber bem e a culinária se tornam protagonistas.</p>
            </div>
            <div class="exp-tipo-card">
                <div class="exp-tipo-icon"><Img src="voss-chef-sf.png" alt="Voss Chef" width={120} /></div>
                <p class="exp-tipo-desc">Experiências de team building gastronômico que unem colaboração e prática. Estrutura completa com 4 bancadas equipadas para dinâmicas culinárias em grupo.</p>
            </div>
            <div class="exp-tipo-card">
                <div class="exp-tipo-icon"><Img src="voss-em-casa-sf.png" alt="Voss em Casa" width={120} /></div>
                <p class="exp-tipo-desc">A assinatura da nossa cozinha no seu dia a dia. Rotisserie premium que combina praticidade, qualidade e sabor afetivo para o conforto do lar.</p>
            </div>
        </div>
    </section>

    <section class="gastronomia">
        <div class="gastro-img"></div>
        <div class="gastro-content">
            <span class="section-tag">Gastronomia</span>
            <h2 class="section-title">Quando a gastronomia <br><em>conduz a experiência</em>
            </h2>
            <p class="section-body">Na Casa VOSS, a gastronomia não entra apenas como apoio, ela participa da narrativa do evento.<br>Assinada pelo Chef Eliézer Formaggio e inspirada pela tradição italiana da família, a cozinha combina técnica, afeto e criatividade em menus desenvolvidos de forma personalizada para cada ocasião.<br>Ao lado de chefs parceiros, a casa cria experiências que transitam entre encontros corporativos, jantares intimistas, ativações gastronômicas e dinâmicas colaborativas.</p>
            <div class="gastro-tags">
                <span class="badge">Menus personalizados</span>
                <span class="badge">Gastronomia italiana contemporânea</span>
                <span class="badge">Chefs parceiros</span>
                <span class="badge">Experiências gastronômicas</span>
            </div>
            <div class="gastro-assinatura">
                <div class="gastro-assinatura-linha"></div><span class="gastro-assinatura-text">Chef Eliézer
                    Formaggio</span>
                <div class="gastro-assinatura-linha"></div>
            </div>
        </div>
    </section>

    <section class="diferenciais">
        <div class="diferenciais-header">
            <span class="section-tag">Estrutura</span>
            <h2 class="section-title">Uma curadoria pensada para integrar estética, funcionalidade<br><em>e experiência em todos os momentos do evento.</em></h2>
        </div>
        <div class="diferenciais-grid">
            <div class="dif-card">
                <div class="dif-card-icon"><svg viewBox="0 0 24 24">
                        <path d="M20 9V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v3" />
                        <path d="M2 11v5a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-5a2 2 0 0 0-4 0z" />
                        <path d="M4 18v2" />
                        <path d="M20 18v2" />
                    </svg></div><span class="dif-card-title">Mobiliário</span>
            </div>
            <div class="dif-card">
                <div class="dif-card-icon"><svg viewBox="0 0 24 24">
                        <path d="M8 2h8l4 10H4L8 2z" />
                        <path d="M12 12v6" />
                        <path d="M8 22v-2a4 4 0 0 1 8 0v2" />
                        <line x1="7" y1="12" x2="7" y2="18" />
                        <line x1="17" y1="12" x2="17" y2="18" />
                    </svg></div><span class="dif-card-title">Bar de drinks</span>
            </div>
            <div class="dif-card">
                <div class="dif-card-icon"><svg viewBox="0 0 24 24">
                        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                        <path d="M12 8v4" />
                        <path d="M10 10h4" />
                    </svg></div><span class="dif-card-title">Paisagismo</span>
            </div>
            <div class="dif-card">
                <div class="dif-card-icon"><svg viewBox="0 0 24 24">
                        <path d="M9 18V5l12-2v13" />
                        <circle cx="6" cy="18" r="3" />
                        <circle cx="18" cy="16" r="3" />
                    </svg></div><span class="dif-card-title">Som e luz</span>
            </div>
        </div>
        <div class="dif-last-row">
            <div class="dif-card">
                <div class="dif-card-icon"><svg viewBox="0 0 24 24">
                        <polygon points="23 7 16 12 23 17 23 7" />
                        <rect x="1" y="5" width="15" height="14" rx="2" />
                        <path d="M8 2v3" />
                        <path d="M16 2v3" />
                    </svg></div><span class="dif-card-title">Cozinha gourmet para gravações</span>
            </div>
            <div class="dif-card">
                <div class="dif-card-icon"><svg viewBox="0 0 24 24">
                        <path d="M6 9H4.5a2.5 2.5 0 0 1 0-5H6" />
                        <path d="M18 9h1.5a2.5 2.5 0 0 0-5H18" />
                        <path d="M4 22h16" />
                        <path d="M10 14.66V17c0 .55-.47.98-.97 1.21C7.85 18.75 7 20.24 7 22" />
                        <path d="M14 14.66V17c0 .55.47.98.97 1.21C16.15 18.75 17 20.24 17 22" />
                        <path d="M18 2H6v7a6 6 0 0 0 12 0V2Z" />
                    </svg></div><span class="dif-card-title">Estrutura para Team Building</span>
            </div>
            <div class="dif-card">
                <div class="dif-card-icon"><svg viewBox="0 0 24 24">
                        <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z" />
                        <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z" />
                    </svg></div><span class="dif-card-title">Estrutura para aulas de gastronomia</span>
            </div>
        </div>
        <div class="dif-actions"><button class="btn-primary" onclick="document.getElementById('contato').scrollIntoView({behavior:'smooth'})">Agende uma visita</button></div>
    </section>

    <section class="manifesto">
        <div class="manifesto-content">
            <h2 class="section-title">Nem todo encontro precisa de formalidade. <em>Alguns precisam de uma atmosfera acolhedora.</em></h2>
            <p class="section-body">A Casa VOSS nasce da união entre experiência em eventos, hospitalidade e gastronomia afetiva.<br><br>Depois de mais de 15 anos atuando com marketing, relacionamento e produção de experiências para grandes grupos corporativos, sua fundadora, Patrícia Formaggio, transformou essa vivência em uma casa pensada para receber pessoas de forma mais humana, sofisticada e intencional.<br><br>Mais do que um espaço para eventos, a Casa VOSS é um lugar onde relações ganham contexto e experiências criam memória.</p>
        </div>
    </section>

    <div class="galeria-header" id="galeria">
        <span class="section-tag">Galeria</span>
        <h2 class="section-title">Ambientes, experiências e detalhes que traduzem a <br><em>essência da Casa VOSS.</em></h2>
    </div>
    <div class="galeria">
        <div class="galeria-item"><Img src="salas.jpg" alt="" width={800} /></div>
        <div class="galeria-item"><Img src="galeria02.jpeg" alt="" width={800} /></div>
        <div class="galeria-item"><Img src="pocket-auditorio.jpg" alt="" width={800} /></div>
        <div class="galeria-item"><Img src="estar.jpg" alt="" width={800} /></div>
        <div class="galeria-item"><Img src="galeria03.png" alt="" width={800} /></div>
        <div class="galeria-item"><Img src="galeria01.jpeg" alt="" width={800} /></div>
    </div>

    <section class="localizacao" id="localizacao">
        <div class="localizacao-content">
            <span class="section-tag">Localização</span>
            <h2 class="section-title">Localização que acompanha<br><em>o ritmo da cidade</em></h2>
            <p class="section-body">Com acesso facilitado e posição estratégica no Brooklin, a Casa VOSS conecta mobilidade, praticidade e conforto para receber eventos corporativos e sociais com mais fluidez.</p>
            <p class="section-body"><b>R. Guaraiúva, 447 — Cidade Monções<br>São Paulo · SP · 04569-000</b></p>
            <div class="loc-actions"><button class="btn-primary" onclick="document.getElementById('contato').scrollIntoView({behavior:'smooth'})">Agende sua visita</button></div>
        </div>
        <div class="localizacao-map">
            <StaticMap
                src="https://maps.google.com/maps?q=R.+Guarai%C3%BAva+447+Cidade+Mon%C3%A7%C3%B5es+S%C3%A3o+Paulo+SP&output=embed&hl=pt-BR&z=16"
                height={480}
            />
        </div>
    </section>

    <!-- ═══ FORMULÁRIO COM CAMPO EMPRESA ═══ -->
    <section class="contato-section" id="contato">
        <div class="contato-info">
            <span class="section-tag">Contato</span>
            <h2 class="section-title">Vamos criar um encontro à altura da<br><em>sua intenção?</em></h2>
            <p class="section-body">Preencha o formulário para receber nosso contato.</p>
        </div>
        <div class="contato-form-wrap">
            <div class="corporativo-form-card">
                <LeadForm
                    formId="corporativo"
                    project="casavoss"
                    submitUrl="https://server3n8n.dmove.com.br/webhook/casa-voss"
                    submitText="SOLICITAR ORÇAMENTO"
                    prefix="corporativo"
                    gridId="corporativoFormGrid"
                    submitId="corporativoSubmitBtn"
                    honeypot={true}
                    successTitle="Solicitação recebida"
                    successText="Recebemos seu pedido de orçamento.<br>Em breve entraremos em contato pelo WhatsApp ou e-mail."
                    fields={[
                        { name: 'form_fields[nome]', id: 'Nome', type: 'text', label: 'Nome', placeholder: 'Nome', autocomplete: 'given-name', maxlength: 100, required: true, full: true, errorText: 'Informe seu nome.', errorId: 'errNome' },
                        { name: 'form_fields[empresa]', id: 'Empresa', type: 'text', label: 'Empresa', placeholder: 'Nome da empresa', autocomplete: 'organization', maxlength: 200, required: true, full: true, errorText: 'Informe sua empresa.', errorId: 'errEmpresa' },
                        {
                            type: 'row',
                            fields: [
                                { name: 'form_fields[telefone]', id: 'Telefone', type: 'tel', label: 'WhatsApp', placeholder: '(11) 9 0000-0000', autocomplete: 'tel', maxlength: 20, required: true, errorText: 'Informe um WhatsApp válido.', errorId: 'errTelefone' },
                                { name: 'form_fields[email]', id: 'Email', type: 'email', label: 'E-mail', placeholder: 'E-mail', autocomplete: 'email', maxlength: 200, required: true, errorText: 'Informe um e-mail válido.', errorId: 'errEmail' },
                            ]
                        },
                        {
                            name: 'form_fields[tipo]', id: 'Tipo', type: 'select', label: 'Tipo de evento', required: true, full: true,
                            errorText: 'Selecione o tipo de evento.', errorId: 'errTipo',
                            options: [
                                { value: '', label: 'Tipo de evento', disabled: true, selected: true },
                                { value: 'Confraternização corporativa', label: 'Confraternização corporativa' },
                                { value: 'Corporativo', label: 'Corporativo' },
                                { value: 'Feiras e Exposições', label: 'Feiras e Exposições' },
                                { value: 'Happy Hour', label: 'Happy Hour' },
                                { value: 'Masterclass e Palestras', label: 'Masterclass e Palestras' },
                                { value: 'Mentorias e Treinamentos', label: 'Mentorias e Treinamentos' },
                                { value: 'Offsite corporativo', label: 'Offsite corporativo' },
                                { value: 'Reuniões de Networking', label: 'Reuniões de Networking' },
                                { value: 'Shows e Festivais', label: 'Shows e Festivais' },
                                { value: 'Workshops, Conferências e Seminários', label: 'Workshops, Conferências e Seminários' },
                                { value: 'Outros', label: 'Outros' },
                            ]
                        },
                        { name: 'form_fields[data]', id: 'Data', type: 'text', label: 'Data pretendida', placeholder: 'Data do evento', readonly: true, required: true, full: true, errorText: 'Informe a data do evento.', errorId: 'errData' },
                        { name: 'form_fields[convidados]', id: 'Convidados', type: 'number', label: 'Quantidade de convidados', placeholder: 'N° de Pessoas', required: true, full: true, errorText: 'Informe o número de pessoas.', errorId: 'errConvidados' },
                        { name: 'form_fields[detalhes]', id: 'Detalhes', type: 'textarea', label: 'Detalhes adicionais', placeholder: 'Conte-nos mais detalhes sobre o seu evento (opcional)', required: false, full: true },
                        { name: 'form_fields[fonte]', id: 'Fonte', type: 'hidden', value: 'Site Casa Voss / Formulário de orçamento' },
                    ]}
                />
            </div>
        </div>
    </section>

    <!-- ═══ WHATSAPP FLOAT + POPUP ═══ -->
    <a href="#" id="wppFloatBtn" class="wpp-float" aria-label="Abrir WhatsApp">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1219.547 1225.016">
            <path fill="#E0E0E0"
                d="M1041.858 178.02C927.206 63.289 774.753.07 612.325 0 277.617 0 5.232 272.298 5.098 606.991c-.039 106.986 27.915 211.42 81.048 303.476L0 1225.016l321.898-84.406c88.689 48.368 188.547 73.855 290.166 73.896h.258.003c334.654 0 607.08-272.346 607.222-607.023.056-162.208-63.052-314.724-177.689-429.463zm-429.533 933.963h-.197c-90.578-.048-179.402-24.366-256.878-70.339l-18.438-10.93-191.021 50.083 51-186.176-12.013-19.087c-50.525-80.336-77.198-173.175-77.16-268.504.111-278.186 226.507-504.503 504.898-504.503 134.812.056 261.519 52.604 356.814 147.965 95.289 95.36 147.728 222.128 147.688 356.948-.118 278.195-226.522 504.543-504.693 504.543z" />
            <linearGradient id="a" gradientUnits="userSpaceOnUse" x1="609.77" y1="1190.114" x2="609.77" y2="21.084">
                <stop offset="0" stop-color="#20b038" />
