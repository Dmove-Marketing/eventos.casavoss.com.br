---
import { Image } from 'astro:assets';
import { isMediaCdn as isMediaCdnUrl, buildResizeUrl, buildSrcset } from '../../lib/media-cdn';

interface Props {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  /** true = eager + fetchpriority high (use na imagem LCP/hero) */
  priority?: boolean;
  quality?: number;
  class?: string;
  style?: string;
  /**
   * Atributo `sizes` do srcset responsivo (só se aplica a imagens do CDN media.dmove.com.br).
   * Padrão: "100vw" — ajuste para imagens que não ocupam a largura toda (ex: grids, cards).
   */
  sizes?: string;
}

const {
  src,
  alt,
  width = 1200,
  height,
  priority = false,
  quality = 80,
  class: className,
  style,
  sizes,
} = Astro.props;

// CDN próprio (media.dmove.com.br): srcset responsivo via redimensionamento sob demanda
const isMediaCdn = isMediaCdnUrl(src);
const isExternal = src.startsWith('http://') || src.startsWith('https://');

// Imagens locais (src/assets/images) só são resolvidas quando não for URL externa
const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/**/*.{jpg,jpeg,png,webp,avif,gif}',
  { eager: true }
);

const key = `/src/assets/images/${src}`;
const mod = !isExternal ? images[key] : undefined;

if (!isExternal && !mod) {
  throw new Error(`[Img] imagem não encontrada: ${key}\nDisponiveis: ${Object.keys(images).join(', ')}`);
}
---

{isMediaCdn ? (
  <img
    src={buildResizeUrl(src, Math.min(width, 2048))}
    srcset={buildSrcset(src, width)}
    sizes={sizes ?? '100vw'}
    alt={alt}
    width={width}
    height={height ?? undefined}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : undefined}
    class={className}
    style={style}
    decoding="async"
  />
) : isExternal ? (
  <img
    src={src}
    alt={alt}
    width={width}
    height={height ?? undefined}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : undefined}
    class={className}
    style={style}
    decoding="async"
  />
) : (
  <Image
    src={mod!.default}
    alt={alt}
    width={width}
    height={height}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : undefined}
    quality={quality}
    class={className}
    style={style}
  />
)}
