---
import { Image } from 'astro:assets';

interface Props {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  /** true = eager + fetchpriority high (use na imagem LCP/hero) */
  priority?: boolean;
  quality?: number;
  class?: string;
  style?: string;
  /**
   * Atributo `sizes` do srcset responsivo (só se aplica a imagens do CDN media.dmove.com.br).
   * Padrão: "100vw" — ajuste para imagens que não ocupam a largura toda (ex: grids, cards).
   */
  sizes?: string;
}

const {
  src,
  alt,
  width = 1200,
  height,
  priority = false,
  quality = 80,
  class: className,
  style,
  sizes,
} = Astro.props;

// CDN próprio (media.dmove.com.br) suporta redimensionamento sob demanda via
// /api/public/resize/:width/clients/... — gera srcset responsivo real a partir dele.
const MEDIA_CDN_PREFIX = 'https://media.dmove.com.br/clients/';
const isMediaCdn = src.startsWith(MEDIA_CDN_PREFIX);
const isExternal = src.startsWith('http://') || src.startsWith('https://');
const RESIZE_WIDTHS = [400, 500, 600, 700, 800, 900, 1000, 1100, 1200, 1600, 2048];

function buildResizeUrl(url: string, w: number) {
  return url.replace('/clients/', `/api/public/resize/${w}/clients/`);
}

function buildSrcset(url: string, maxWidth: number) {
  const cap = Math.min(maxWidth * 2, 2048); // até 2x para telas retina
  const chosen = new Set(RESIZE_WIDTHS.filter((w) => w <= cap));
  chosen.add(Math.min(maxWidth, 2048));
  return [...chosen]
    .sort((a, b) => a - b)
    .map((w) => `${buildResizeUrl(url, w)} ${w}w`)
    .join(', ');
}

// Imagens locais (src/assets/images) só são resolvidas quando não for URL externa
const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/images/**/*.{jpg,jpeg,png,webp,avif,gif}',
  { eager: true }
);

const key = `/src/assets/images/${src}`;
const mod = !isExternal ? images[key] : undefined;

if (!isExternal && !mod) {
  throw new Error(`[Img] imagem não encontrada: ${key}\nDisponiveis: ${Object.keys(images).join(', ')}`);
}
---

{isMediaCdn ? (
  <img
    src={buildResizeUrl(src, Math.min(width, 2048))}
    srcset={buildSrcset(src, width)}
    sizes={sizes ?? '100vw'}
    alt={alt}
    width={width}
    height={height ?? undefined}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : undefined}
    class={className}
    style={style}
    decoding="async"
  />
) : isExternal ? (
  <img
    src={src}
    alt={alt}
    width={width}
    height={height ?? undefined}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : undefined}
    class={className}
    style={style}
    decoding="async"
  />
) : (
  <Image
    src={mod!.default}
    alt={alt}
    width={width}
    height={height}
    loading={priority ? 'eager' : 'lazy'}
    fetchpriority={priority ? 'high' : undefined}
    quality={quality}
    class={className}
    style={style}
  />
)}
